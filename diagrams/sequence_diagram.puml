@startuml sequence_diagram
title Heislab - Sekvensdiagram

skinparam defaultFontSize 14
skinparam sequenceMessageAlign center

participant "main" as MAIN
participant "orders" as ORD
participant "fsm" as FSM
participant "elevio" as HW

== Initialisering ==

MAIN -> HW  : elevio_init()
MAIN -> ORD : orders_init()
MAIN -> FSM : fsm_init() → state = idle

== Hovedløkke ==

loop 10ms tick
    MAIN -> ORD : orders_poll()
    MAIN -> FSM : fsm_run(TICK)
end

== Ny bestilling mottas ==

ORD -> ORD : orders_add(floor, button)
FSM -> ORD : orders_choose_direction() → dir
FSM -> HW  : motorDirection(dir)
FSM -> FSM : state = moving

== Heisen ankommer riktig etasje ==

FSM -> ORD : orders_should_stop() → true
FSM -> HW  : motorDirection(STOP)
FSM -> ORD : orders_clear_at_floor()
FSM -> HW  : doorOpenLamp(ON)
FSM -> FSM : state = door_open, start timer

== Timer utløper (3 sek) ==

FSM -> HW  : doorOpenLamp(OFF)
alt Flere ordre
    FSM -> ORD : orders_choose_direction() → dir
    FSM -> HW  : motorDirection(dir)
    FSM -> FSM : state = moving
else Ingen ordre
    FSM -> FSM : state = idle
end

@enduml
