@startuml class_diagram
title Heislab - Klassediagram

skinparam classAttributeIconSize 0

enum MotorDirection {
    DIRN_DOWN  = -1
    DIRN_STOP  =  0
    DIRN_UP    =  1
}

class FSM {
    - current_floor : int
    - current_direction : MotorDirection
    - state : state_fp
    --
    + fsm_init()
    + fsm_run(event)
    + fsm_transition(new_state)
    --
    + state_idle(event)
    + state_moving(event)
    + state_door_open(event)
    + state_stop(event)
}

class Orders {
    - orders[N_FLOORS][N_BUTTONS] : int
    - orders_blocked : int
    --
    + orders_init()
    + orders_add(floor, button)
    + orders_clear_at_floor(floor)
    + orders_clear_all()
    + orders_any() : bool
    + orders_should_stop(floor, dir) : bool
    + orders_choose_direction(floor, dir) : MotorDirection
    + orders_poll()
}

FSM --> Orders : orders_any()\norders_should_stop()\norders_choose_direction()\norders_clear_at_floor()
FSM ..> MotorDirection
Orders ..> MotorDirection

@enduml
